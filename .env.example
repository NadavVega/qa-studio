DATABASE_URL=postgres://qa:qa@localhost:5433/qa_studio
# LLM providers (all optional). A provider is connected when its var is set; pick the model in Settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama or any OpenAI-compatible server, e.g. http://localhost:11434
OLLAMA_BASE_URL=
# live | replay | record
LLM_MODE=live
EVIDENCE_DIR=./data/evidence
# Sign-in for the application under test; environments name these vars in authConfig.
APP_USER=
APP_PASSWORD=
# Env vars the worker may read for environment authConfig (comma-separated).
CREDENTIAL_ENVS=APP_USER,APP_PASSWORD
# Folder of spec files for Knowledge & Config > Import, relative to the repo root.
# INPUTS_DIR=./docs/inputs
# GitHub connection (worker only). Fine-grained token: pull requests + releases read, commit statuses write
# (pull request comments write only if enabled). Projects name the var in Knowledge & Config > Integrations.
GITHUB_TOKEN=
# Optional: POST /github/webhook verifies deliveries with this secret; unset = webhook off.
GITHUB_WEBHOOK_SECRET=
# Link target in commit statuses.
WEB_URL=http://localhost:3000
# Private demo profile (see demo-local.example/README.md). on = demo-local datasets, projects and models.json are used.
# DEMO_MODE=off
# DEMO_DATA_DIR=./demo-local
