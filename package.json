{
  "name": "qa-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "concurrently -n web,api,worker,sim -c cyan,green,yellow,magenta \"pnpm --filter @qa/web dev\" \"pnpm --filter @qa/api dev\" \"pnpm --filter @qa/worker dev\" \"pnpm --filter @qa/sim dev\"",
    "db:generate": "pnpm --filter @qa/db generate",
    "db:migrate": "pnpm --filter @qa/db migrate",
    "db:seed": "pnpm --filter @qa/db seed",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm check:private",
    "demo": "tsx --env-file-if-exists=.env scripts/demo-local.ts demo",
    "check:private": "tsx scripts/check-private.ts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/demo-local.ts seed"
  },
  "devDependencies": {
    "@qa/core": "workspace:*",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
